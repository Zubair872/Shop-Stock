# ---- Zaroori ----
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/shop-stock?retryWrites=true&w=majority
# Kam az kam 32 characters. Banane ke liye:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Production mein zaroor dekhein ----
NODE_ENV=production
# Frontend ka address (comma se alag karke kai). Frontend aur backend alag domain par hon to zaroori.
CORS_ORIGIN=https://your-frontend.example.com
# Pehla account banane ke baad "false" kar dein taake koi aur register na kar sake
ALLOW_REGISTRATION=true
# Reverse proxy (nginx / Vercel) ke peeche hone par 1; seedha internet par ho to false
TRUST_PROXY=1

# ---- Optional (yeh defaults hain) ----
PORT=3001
SHOP_TIMEZONE=Asia/Karachi
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
EXPIRY_WARNING_DAYS=3
TRIAL_DAYS=7
SUPPORT_WHATSAPP=923001234567

# ---- Super Admin (Owner of software) ----
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@shopstock.pk
SUPERADMIN_PASSWORD=change-this-password

# ---- Sirf `npm run migrate` ke liye (purane JSON data ko Mongo mein le jane ka script) ----
OWNER_NAME=Shop Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-this-password
OWNER_SHOP_NAME=My Bakery
